rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: get user role from users collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && getUserRole() == 'admin';
    }

    function isFaculty() {
      return isAuth() && getUserRole() == 'faculty';
    }

    function isInternalReviewer() {
      return isAuth() && getUserRole() == 'internal_reviewer';
    }

    function isExternalReviewer() {
      return isAuth() && getUserRole() == 'external_reviewer';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuth() && request.auth.uid == userId && request.resource.data.role == 'faculty';
      allow update: if isAdmin() || (
        isAuth() && request.auth.uid == userId && request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin();
    }

    // Applications collection
    match /applications/{appId} {
      // Application records are only accessed through the role-filtering backend API.
      allow read, create, update, delete: if false;

      // Internal reviews subcollection
      match /internalReviews/{reviewId} {
        allow read, create, update, delete: if false;
      }

      // External reviews subcollection
      match /externalReviews/{reviewId} {
        allow read, create, update, delete: if false;
      }

      // Reviewer criterion-linked comments — reviewers and admins only, never applicants
      match /reviewerComments/{commentId} {
        allow read, create, update, delete: if false;
      }

      match /{subcollection}/{document=**} {
        allow read, write: if false;
      }
    }

    // All users list (for admin)
    match /users/{userId} {
      allow list: if isAdmin();
    }
  }
}
