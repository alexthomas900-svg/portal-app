{
  "name": "portal-app-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "demo": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 GCLOUD_PROJECT=demo-fcportal FIREBASE_STORAGE_BUCKET=demo-fcportal.appspot.com CORS_ORIGINS=http://localhost:5173 PORT=5000 tsx watch src/index.ts",
    "seed:demo-users": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=demo-fcportal tsx src/scripts/seedDemoUsers.ts",
    "seed:demo-data": "cross-env FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 BACKEND_URL=http://localhost:5000 tsx src/scripts/seedDemoData.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "firebase-admin": "^13.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
