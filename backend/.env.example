PORT=5000
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
CORS_ORIGINS=https://your-firebase-project.web.app,https://your-firebase-project.firebaseapp.com

# ── Local Firebase Emulator Suite (no real credentials needed) ──
# Leave FIREBASE_SERVICE_ACCOUNT_JSON unset and instead set these so the
# backend connects to `firebase emulators:start` instead of production.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# GCLOUD_PROJECT=demo-fcportal
