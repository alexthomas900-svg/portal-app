VITE_FB_API_KEY=your-api-key
VITE_FB_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FB_PROJECT_ID=your-project-id
VITE_FB_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FB_MESSAGING_SENDER_ID=your-sender-id
VITE_FB_APP_ID=your-app-id
VITE_DEMO_EMAIL=demo@fccollege.edu.pk
VITE_DEMO_PASSWORD=Demo@12345
VITE_ENABLE_DEMO_SEED=true
VITE_API_URL=http://localhost:5000

# Set to "true" to point the app at the local Firebase Emulator Suite instead
# of the live Firebase project — no real Firebase credentials needed.
# See DEMO.md "Local emulator demo" for the full local-testing walkthrough.
VITE_USE_FIREBASE_EMULATOR=false
